/*Sobre a Santa Casa*/
.texto-padding{
	padding: 20px 15px;
}
.texto-white{
	color: #fff;
}
.barra-white>div{
	background-color: #fff !important;
}
.bg-gray{
	background-color: #f5f5f5;
}
.provedores{
	text-align: center;	
}
.provedor{
	display: inline-block;
	width: 170px;
	height: 250px;
	margin: 40px 10px 0 10px;
}
.provedor img, .provedor .textos{
	display: block;
	float: left;
}
.provedor img{
	width: 100%;
	height: 170px;
	border-radius: 100%;
}
.provedor .textos{
	width: 100%;
	text-align: center;
	padding: 15px 0 0 0;
}
.provedor .textos h3{
	color: #616161 !important;
	font-size: 16px;
}
.provedor .textos h4{
	font-size: 14px;
}
.provedor .textos h3, .provedor .textos h4{
	margin: 0;
}

.sobre-bloco-missao .textos h3{
	text-transform: uppercase;
	margin-top: 0;
}
#galeria-sobre .item img{
	width: 100%;
}
