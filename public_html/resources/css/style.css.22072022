/*Segurança do Paciente*/
.bloco-seguranca{
	padding-bottom: 15px;
}
.bloco-seguranca .titulos{
	margin-bottom: 0;
}
.bloco-seguranca .conteudo-texto{
	padding: 40px;
}
/*/Segurança do Paciente*/





/*Portal de Transparencia*/
.container-pdf{
	text-align: center;
}
.item-pdf{
	display: inline-block;
	width: 185px;
	margin: 0 10px;
	text-align: center;
}
.img-pdf img, .img-pdf svg{
	width: 100px;
}
.ano-pdf{
	display: inline-block;
	width: 98%;
	height: 30px;
	line-height: 30px;
	text-align: center;
	border-radius: 0 0 8px 8px;
	color: #fff;
	border-top: 1px solid transparent;
	border-bottom: 1px solid rgba(100,100,100, 0.3);
	border-right: 1px solid rgba(100,100,100, 0.3);
	border-left: 1px solid rgba(100,100,100, 0.3);
}
.icon-pdf{
	width: 1em;
	display: inline-block;
}
.btn{
	width: 100%;
	margin-bottom: 5px;
}
.btn.bg-blue{
	color: #fff;
}
.container-pdf .item-pdf .conteudo a{
	font-size: 1.2em;
	/*font-weight: 600;*/
}
/*/Portal de Transparencia*/





/*Pronto Atendimento*/
.bloco-atendimento{
	display: block;
	padding: 15px;
	box-shadow: 0 2px 4px -2px #888;
	margin-top: 40px;
	text-align: justify;
	border-radius: 5px;
}
.padd15{
	padding: 15px;
}
.img-atedimento{
	padding: 0;
}
.img-atedimento img{
	display: block;
	margin-left: auto; 
	margin-right: auto; 
	margin-bottom: 15px;
}
.texto-atendimento h2{
	font-size: 20px;
	font-weight: 600;
	color: #616161;
}
.bloco-conteudo-padding .titulo-barra h3{
	padding-bottom: 0;
	margin-bottom: 0;
}
.bloco-conteudo-padding .album{
	max-width:40%; 
	margin-left: 8%;
}
.bloco-conteudo-padding .album-desc{
	text-align: justify;
	width:49%;
	float: right;
	font-size: 16px;
	color: #616161;/*
	vertical-align: center;*/
}
.bloco-conteudo-padding .album-desc p{
	vertical-align: center;
}

/*/Pronto Atendimento*/





/*Especialidades*/
.especialidades{
	text-align: center;
}
.especialidade{
	padding: 20px;
	margin: 1%;
	width: 31%;
	display: inline-block;
	background-color: #fff;
	box-shadow: 0px 2px 4px -2px #22222221;
	text-align: left;
	font-size: 18px;
	border-radius: 5px;
	font-weight: 500;
}
.especialidade img{
	height: 20px;
	margin-right: 15px;
}
/*/Especialidades*/






/*Capacidade intalações*/
.item-capacidade{
	box-shadow: 0 2px 4px -2px #888;
	margin-bottom: 40px;
	position: relative;

	-webkit-border-radius:6px;
	-moz-border-radius:6px;
	border-radius:6px;
	overflow: hidden;
}
.item-capacidade .carousel-capacidade, .item-capacidade .area-conteudo{
	width: 50%;
	height: 100%;
	float: left;
}
.item-capacidade .img-capacidade{
	width: 50%;
	float: left;
}
.item-capacidade .area-conteudo {
	position: absolute;
	top: 0;
	right: 0;
	height: 100%;
}
.item-capacidade .area-conteudo .conteudo {
	width: 100%;
	position: absolute;
	top: 50%;
	right: 0;
	margin-top: -20%;
	padding: 15px;
}
.carousel-capacidade .owl-controls{
	/*
	position: absolute;
	top: 10%;
	right: 0;
	height: 100%;
	*/
	position: absolute;
    bottom: -180px;
    right: 40%;
    height: 100%;
    width: 100%;
}
.carousel-capacidade .owl-dots{
	position: absolute;
	top: 50%;
	right: 0;
	margin-top: -50px;
}
/*Capacidade intalações*/





/*Manual*/
.item-manual{
	width: 100%;
	float: left;
	background-color: white;
	box-shadow: 0 2px 4px -2px #888;
	margin-bottom: 20px;
}
.item-manual header{
	width: 100%;
	float: left;
	border-bottom: 1px solid rgba(150,150,150,0.3);
	padding: 15px;
	font-size: 18px;
	font-weight: 600;
	text-align: left;
	/*line-height: 40px;*/
	vertical-align: middle;
}
.item-manual header img{
	float: left;
	height: 20px;
	margin-top: 10px;
	margin-right: 20px;
}
.item-manual header button{
	width: 150px;
	float: right;
}
.item-manual article{
	padding: 15px  40px;
	display: none;
	float: left;
}
.item-manual strong{
	float: left;
}
/*/Manual*/

.galeria-diagnostico_por_imagem { margin-bottom: 40px; }








