.voluntariado .conteudo{
	margin-bottom: 20px;
}
.voluntariado-imagem{
	padding: 0;
	margin: 0;
}
.voluntariado-imagem img{
	width: 100%;
}
.barra-half{
	width: 50%;
}
.upper{
	text-transform: uppercase;
}
.lower{
