/* Footer */
.fonte2.f-white {
	color: #fff;
	font-size: 13px;
}
.bg-footer{
	background-color: #FFF;
	fill: currentColor;
}
.bg-footer .bloco-conteudo-padding{
	padding-top: 60px;
	padding-right: 30px;
	padding-left: 30px;
	margin-top: -20px;
	margin-bottom: 15px;
	background-color: #29b6f6;
}

.bg-footer h2{
	font-size: 14px;
	color: #FFF;
	text-transform: uppercase;
	/*padding-bottom:30px;*/
	font-weight: 500;
}
.bg-footer p{
	color: #FFF;
	text-transform: none;
	padding-bottom:30px;
	font-size: 14px;
}
.bg-footer a{
	color: #FFF;
}
.bg-footer .icons{
	width: 25px;
	float: left;
	margin-right: 5px;
	margin-top: 5px;
	color: #fff;
}
.bg-footer .input-bloco{
	padding: 5px 15px 8px 25px;
	border:#FFF solid 1px;
	-webkit-border-radius:35px;
	-moz-border-radius:35px;
	border-radius:35px;
}
.bg-footer .input-bloco input{
	width: 80%;
	display: inline-block;
	background-color: transparent;
	border: transparent;
	color: #FFF !important;
	box-shadow: none !important;
	text-transform: uppercase;
	padding: 0 5px;
}
.bg-footer .input-bloco input::-webkit-input-placeholder { /* Chrome/Opera/Safari */
  color: #FFF !important;
}
.bg-footer .input-bloco input::-moz-placeholder { /* Firefox 19+ */
  color: #FFF !important;
}
.bg-footer .input-bloco input:-ms-input-placeholder { /* IE 10+ */
  color: #FFF !important;
}
.bg-footer .input-bloco input:-moz-placeholder { /* Firefox 18- */
  color: #FFF !important;
}
.bg-footer .input-bloco button{
	width: 10%;
	display: inline-block;
	background-color: transparent;
	border: none;
	margin-top: 2px;
}
.bg-footer .input-bloco button i{
	color: #FFF;
	font-size: 24px;
}
.bg-footer .facebook{
	width: 45px;
	height: 45px;
	border: solid 2px #FFF;

	-webkit-border-radius:45px;
	-moz-border-radius:45px;
	border-radius:45px;

	float: left;
	margin-right: 10px;
	margin-top: -2px;
}
.bg-footer .facebook .icons{
	width: 40px;
	margin-top: -2px;
	margin-left: -2px;
}
.bg-footer .telefone{
	margin-top:-2px
}

/*Humanização - jf*/
.titulos{
	/*margin-bottom: 40px;*/
	text-align: justify;
}
.acoes-sociais .titulos{
	margin-bottom: 0;
	text-align: justify;
}
.titulos h2{
	font-weight: 600;
	font-size: 22px;
}
.acoes-sociais .titulos{
	margin-bottom: 15px;
}

.voluntariado-imagem{
	width: 50%;
	margin-right: 15px;
}

.titulo-no-margin{
	margin-bottom: 0;
}
.textos{
	text-align: justify;
}
.textos h3{
	font-size: 18px;
	font-weight: 700;
	color: #e91122;
}
.textos.texto2{
	margin-top: 40px;
}
.textos ul{
	list-style: none; 
}
.textos.texto-padding{
