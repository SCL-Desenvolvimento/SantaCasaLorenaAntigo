/*media query scren and MAX width*/
@media screen and (max-width: 544px) {
	.bloco-atendimento { padding: 20px 0; }
	.titulos h2{
		font-size: 18px;
	}
	.contra-image{
		height: 280px;
	}
	.paginacao .pagination li:first-child a, .paginacao .pagination li:last-child a{
		font-size: 0px;
	}
	.icon-sobre{
		display: none;
	}
	.sobre-bloco-missao .col-xs-10{
		width: 100%;
	}
	.bloco-conteudo-padding .album{
		max-width: 100% !important;
		width: 100% !important;
	}
	.bloco-conteudo-padding .album img{
		max-width: 100% !important;
		margin-bottom: 20px;
	}
	#map-canvas{
		height: 200px; 
	}
	.item-manual button{
		width: auto !important;
		padding: 2px;
	}
	.item-manual header {
		height: auto;
	}
}
@media screen and (max-width: 950px) {
	.bg-noticias .bloco-conteudo-padding{
		padding: 0 15px;
	}
}

@media screen and  (min-width: 806px) and (max-width: 1120px) {
	.bloco-conteudo-padding .titulo-barra{
		padding-left: 0 !important;
	}
	.bloco-conteudo-padding .album{
		margin-left: 0 !important;
	}
}
@media screen and (max-width: 767px) {
	.menu-principal	.dropdown-menu>li>a {
		white-space: normal;
	}
	.navbar-nav  {
		display: inline;
	}
	.navbar-default .navbar-brand {
		display: inline;
	}
	.navbar-default .navbar-toggle .icon-bar {
		background-color: #fff;
	}
	.navbar-default .navbar-nav .dropdown-menu > li > a {
		color: red;
		/*background-color: #ccc;*/
		border-radius: 4px;
		margin-top: 2px;   
	}
	.nav .open>a, .nav .open>a:focus, .nav .open>a:hover{
		background-color: #fff !important;
	}
	.navbar-default .navbar-nav .open .dropdown-menu > li > a {
		color: #333;
	}/*
	.navbar-default .navbar-nav .open .dropdown-menu > li > a:hover,
	.navbar-default .navbar-nav .open .dropdown-menu > li > a:focus {
		background-color: #ccc;
	}*/
	.navbar-nav .open .dropdown-menu {
		border-bottom: 1px solid white; 
		border-radius: 0;
	}
	.dropdown-menu {
		padding-left: 10px;
	}
	.dropdown-menu .dropdown-menu {
		padding-left: 20px;
	}
	.dropdown-menu .dropdown-menu .dropdown-menu {
		padding-left: 30px;
	}
	li.dropdown.open {
		border: 0px solid red;
	}
	.bloco-conteudo{
		padding: 0;
	}
	li.btn-facebook a{
		padding: 5px 6px !important;
	}
	.bloco-conteudo-padding{
		padding: 25px 0;
	}
	.contra-titulo{
		text-align: left;
	}
	.convenios{
		display: none;
	}
	.carousel-convenios .owl-controls{
		display: block;
	}
	.bloco-servicos .img, .bloco-institucional .img{
		height:200px;
	}
	.bloco-instalacoes{
		margin-top: 0px;
	}
	.bloco-conteudo-padding .titulo{
		margin-bottom: 10px;
	}
	header nav .navbar-nav{
		float: none !important;
	}
	header .nav>li>a {
		font-size: 12px;
	}
	.titulo-pagina{
		padding: 15px;
	}
	.bg-topo-paginas{
		border: none;
	}
	.contra-image{
		height: 350px;
	}
	.bg-footer .bloco-conteudo-padding{
		margin-bottom: 0;
	}
	.btn-compartilhar, .tags{
		margin: 0;
		padding: 15px;
	}
	.voluntariado-imagem{
		width: 100%;
	}
	.clearResp{
		height: 0;
	}
	.bloco-conteudo-padding .album{
		max-width: 70%;
		width: 70%;
		margin:0;
		max-width:auto; 
		margin: 0 auto;
	}
	.item-manual header img{
		display: none;
	}
	.item-manual strong{
		width: 200px;
	}
	.mais-lidas{
		display: none;
	}
}
@media screen and (max-width: 805px) {
	.bloco-seguranca .conteudo-texto{
		padding: 15px;
	}
	.bloco-servicos .img, .bloco-institucional .img{
		width: 100%;
	}
	.bloco-servicos .conteudo-texto, .bloco-institucional .conteudo-texto{
		width: 100%
	}
	.bloco-servicos .conteudo-texto a, .bloco-institucional .conteudo-texto a{
		padding: 5px 10px;
		text-align: center;
	}
	.bloco-institucional .img-responsive{
		display: block !important;
	}
	.bloco-institucional .img-desktop{
		display: none !important;
	}
	.bloco-institucional{
		margin-top: 50px;
	}
	.bg-noticias{
		padding: 20px 15px;
		border:none;
	}
	li.btn-facebook a span {
		padding: 13px 5px 9px;
	}
	.btn-doacao {
		padding: 12px 12px 10px;
	}
	header .nav>li>a {
		padding: 10px 5px;
		font-size: 10px;
	}
	.menu-principal ul li {
		margin: 0;
	}
	.menu-principal ul li.dropdown a i {
		margin: 0 12px;
	}
	.bloco-conteudo-padding .titulo-barra{
		padding-left: 15px;
	}
	.bloco-conteudo-padding .album{
		max-width: 61%;
		width: 70%;
		margin:0;
		max-width:auto; 
		margin: 0 auto;
	}
	.bloco-conteudo-padding .album-desc{
		float: none;
		width:auto;
	}
	.especialidade{
		width: 100%;
	}
	.contra-titulo-paginas{
		padding-top: 0px;
	}
}
@media screen and (max-width: 1120px) {
	.bloco-conteudo-padding {
	    padding: 50px 20px;
	}
}
@media screen and (max-width: 640px){
	.especialidade {
	    width: 100% !important;
	}
}
@media screen and (max-width: 992px) {
	.contra-titulo-noticia{
		float: left !important;
		padding-top: 10px !important;
	}

	.pagina-noticias .img{
		margin-bottom: 20px;	
		background-position: center;	
	}
	.barra-half{
		width: 100%;
	}
	.clearResp{
		clear: both;
		height: 20px;
	}
	.voluntariado .textos-pad-top{
		padding-top: 0;
	}
	.texto-atendimento h2{
		text-align: center;
	}
	.texto-atendimento p{
		margin-top: 20px;
	}
	.especialidade{
		width: 48%;
	}
	.bloco-conteudo-padding .album img{
		max-width: 320px !important;
		margin-bottom: 20px;
	}
	.bloco-conteudo-padding .album-desc{
		width:41%;
		font-size: 14px;
	}

	.item-capacidade{
		margin-bottom: 20px;
	}
	.item-capacidade .carousel-capacidade, .item-capacidade .area-conteudo{
		width: 100%;
		height: auto;
	}
	.item-capacidade .img-capacidade{
		width: 100%;
	}
	.item-capacidade .area-conteudo {
		position: static;
		height: auto;
	}
	.item-capacidade .area-conteudo .conteudo {
		position: static;
		top: 0;
		margin-top: 0;
	}
	.carousel-capacidade .owl-controls{
		position: static;
		height: auto;
		width: 100%;
	}
	.carousel-capacidade .owl-dots{
		position: static;
		margin-top: 0;
		margin-right: 0;
	}

	.bg-footer .bloco-conteudo-padding > div{
		padding-bottom: 10px; 
		margin-bottom: 25px;
		border-bottom: solid #FFF 1px;
	}
	.bg-footer .bloco-conteudo-padding .clear{
		padding-bottom: 0 !important; 
		margin-bottom: 0 !important;
		border-bottom: none !important;
	}
	.bg-footer .bloco-conteudo-padding > div:last-child{
		padding-bottom: 0 !important; 
		margin-bottom: 0 !important;
		border-bottom: none !important;
	}
	.item-manual strong{
		width: 400px;
		float: left;
	}
	.item-manual header {
		height: 110px;
	}
}
@media screen and (max-width: 550px) {
	.item-manual article{
		float: none !important; 
		padding: 15px;
	}
	.bloco-paciente{
		padding: 15px 0 !important;
	}
}

@media screen and (max-width: 1170px) {
	header .navbar-brand{
		padding-left: 15px;
	}
	header .nav>li>a {
		padding: 10px 2px;
		font-size: 12px;
	}
	.btn-doacao{
		padding: 12px 20px 10px;
	}
	li.btn-facebook a{
		padding: 5px 0 !important;
	}
	li.btn-facebook a span{
		padding: 13px 10px 9px;
	}
	.noticias h2{
		height: auto;
	}
	.noticias p{
		height: auto;
	}

	.bg-noticias .owl-controls{
		display: block;
	}
	.paginacao .pagination li a{
		padding:5px;
	}
	.paginacao .pagination li:first-child a, .paginacao .pagination li:last-child a{
		font-size: 14px;
		padding:5px;
	}
	.voluntariado .textos-pad-top{
		padding-top: 5vw;
	}
	.bloco-conteudo-padding .album img{
		max-width: 380px !important;
	}
	.bloco-conteudo-padding .album-desc{
		width:40%;
	}
	.item-capacidade p{
		font-size: 14px;
	}
}
@media screen and (max-width: 1200px) {
	.voluntariado .textos-pad-top{
		padding-top: 7vw;
	}
	.bloco-conteudo-padding .album img{
		max-width: 400px !important;
	}
	.bloco-conteudo-padding .album-desc{
		width:41%;
	}
	.conteudo-paginas-padding{
		padding:15px;
	}
	.item-capacidade .area-conteudo .conteudo{
		top:30%;
	}
}
@media screen and (max-width: 1300px) {
	.voluntariado .textos-pad-top{
		padding-top: 7vw;
	}
	.bloco-conteudo-padding .album-desc{
		width:45%;
	}
	.item-capacidade .area-conteudo .conteudo{
		top:40%;
	}
}
@media screen and (max-width: 1366px){
	#galeria-humanizacao{
		display: none;
	}
	#galeria-humanizacao-mobile{
		display: block;
	}
}
@media screen and (max-width: 1380px) {
	.item-capacidade h2{
		font-size: 20px;
	}
}
@media screen and (max-width: 805px) {
	.bloco-conteudo-padding .album-desc{
		width: 100%;
	}
}

/*-----------------------------------------------------------------------------------------------------------------------------------------*/
/*media query scren and MIN width*/
@media screen and (min-width: 768px) {
	.menu-principal ul li a{
		background-color: transparent !important;
	}
}
@media screen and (min-width: 993px) {
	.album-internacao .owl-controls{
		/*
		height: 100%;
		width: 24px;
		position: absolute;
		top: 0;
		right: 0;
		*/

    	width: 100%;
    	position: absolute;
        bottom: -25px;
    	right: 40%;
	}

	#galeria-sobre .owl-controls{
		width: 100%;
    	position: absolute;
	}

	.album-internacao .owl-controls{
		right: 20px;
	}
	.album-internacao .owl-dots, #galeria-sobre .owl-dots{
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		margin-top: -50px;
	}
}
@media screen and (min-width: 1367px){
		.voluntariado .textos-pad-top{
		padding-top: 100px;
	}
}

